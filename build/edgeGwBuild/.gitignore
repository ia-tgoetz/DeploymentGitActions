# Don't commit binaries — operators stage them locally before building
# or pushing. The image baked from this directory is the distribution
# artifact, not the source binaries.
*.modl

# Defensive: never commit private-key-bearing keystores or cert
# bundles, even when the automated fleet-cert pipeline isn't in use.
# (The pipeline lived here previously — see tag archive/fleet-cert-stack.)
metro-keystore
*.p12
*.pfx
*.jks
*.key
