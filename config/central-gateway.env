# Central Ignition Gateway connection details (Gateway Network outgoing).
# Fill this in for the site this IPC belongs to, then commit it.
# This file is NOT a secret — addresses and ports are not sensitive.
#
# These variables are sourced by .github/workflows/deploy.yml and become
# GATEWAY_NETWORK_0_* env vars in the container, which Ignition reads on
# the first boot of a fresh gateway DB to seed an outgoing GAN connection.
# Re-deploys after the first boot do not re-apply these values; manage
# the connection via the gateway web UI thereafter.

# Hostname / IP of the central Ignition Gateway (Hub)
GAN_HOST=engine-demo.chariot.io

# Gateway Network port on the Hub (default 8060 for SSL)
GAN_PORT=8060

# Ping interval in milliseconds
GAN_PINGRATE=1000

# Whether the connection uses TLS. Almost always true for cross-site links.
# Pair with a public cert in services/pki/trusted/clients/ to bypass the
# cert-quarantine step on first boot.
GAN_ENABLESSL=true

# Whether the connection is enabled at startup
GAN_ENABLED=true
