# Central Ignition Gateway connection details
# Fill this in for the site this IPC belongs to, then commit it.
# This file is NOT a secret — addresses and ports are not sensitive.

# Hostname or IP of the central Ignition Gateway
CENTRAL_GW_HOST=

# Gateway Area Network (GAN) port on the central gateway (default: 8060)
CENTRAL_GW_PORT=8060

# Name that will identify this Edge gateway inside the central GW's GAN view
# Recommended convention: site-name or asset-tag (e.g., "site-dallas-01")
CENTRAL_GW_CONNECTION_NAME=edge-site

# Optional: central gateway HTTP port (used only for manual verification)
CENTRAL_GW_HTTP_PORT=8088
