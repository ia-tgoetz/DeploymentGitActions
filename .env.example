##########################################
#
# Environment variable file for
# Ignition 8.3 Edge IPC deployment
#
# Copy to .env and fill in values.
# .env is gitignored — never commit it.
#
##########################################


### Shared
TZ=America/Chicago

### Ignition
IGN_RELEASE=8.3.6

# Image source — defaults to your private GHCR mirror.
# Override to inductiveautomation/ignition:8.3.6 for local dev if you don't
# have GHCR access yet.
IGNITION_IMAGE=ghcr.io/ia-tgoetz/ignition:8.3.6

IGN_NAME=ignition-edge
IGN_PORT=8088
IGN_HTTPS_PORT=8043
IGN_GAN_PORT=8060
IGN_UID=1000
IGN_GID=1000
IGN_MODE=prod

### Gateway credentials
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=changeme

### Third-party modules to auto-accept on first boot
# Comma-separated module IDs — the value of the <id> element inside the
# .modl's module.xml. For Cirrus Link MQTT Transmission 5.0.3 that's
# com.cirruslink.mqtt.transmission.gateway (the .gateway IS part of the
# real module ID — not just the resource-folder path).
# Verify with: python3 -c "import zipfile; print(zipfile.ZipFile('services/modules/<file>.modl').read('module.xml').decode())"
GATEWAY_MODULES_ACCEPTED=com.cirruslink.mqtt.transmission.gateway
ACCEPT_MODULE_LICENSES=com.cirruslink.mqtt.transmission.gateway
ACCEPT_MODULE_CERTS=com.cirruslink.mqtt.transmission.gateway

### GitHub Container Registry Information Used for Transfering Containter images to GHCR
GHCR_OWNER=<userName>
GHCR_PAT=<token>