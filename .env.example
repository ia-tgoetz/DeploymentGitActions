##########################################
#
# Environment variable file for
# Ignition 8.3 Edge IPC deployment
#
# Copy to .env and fill in values.
# .env is gitignored — never commit it.
#
##########################################


### Shared
TZ=America/Chicago

### Ignition
IGN_RELEASE=8.3.6
IGN_NAME=ignition-edge
IGN_PORT=8088
IGN_HTTPS_PORT=8043
IGN_GAN_PORT=8060
IGN_UID=1000
IGN_GID=1000
IGN_MODE=prod

### Gateway credentials
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=changeme
