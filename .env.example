##########################################
#
# Environment variable file for
# Ignition 8.3 Edge IPC deployment
#
# Copy to .env and fill in values.
# .env is gitignored — never commit it.
#
##########################################


### Shared
TZ=America/Chicago

### Ignition
IGN_RELEASE=8.3.6

# Image source — derived image with Cirrus Link MQTT Transmission baked in.
# Built once from build/edgeGwBuild/Dockerfile and pushed to GHCR via
# scripts/push-image-to-ghcr.sh. IPCs pull this; no runtime module install.
IGNITION_IMAGE=ghcr.io/ia-tgoetz/ignition-edge:8.3.6

IGN_NAME=ignition-edge
IGN_PORT=8088
IGN_HTTPS_PORT=8043
IGN_GAN_PORT=8060
IGN_UID=1000
IGN_GID=1000
IGN_MODE=prod

### Gateway credentials
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=changeme

### Container resource limits (host-side cap)
# IGN_MAX_HEAP is the JVM -m value in MB (max Java heap inside the container).
# IGN_MEM_LIMIT is the Docker container memory cap; should exceed IGN_MAX_HEAP
# to leave room for off-heap, DB caches, and OS overhead inside the container.
# IGN_CPUS is the CPU quota (decimal, can be fractional, e.g. 1.5).
IGN_MAX_HEAP=2048
IGN_MEM_LIMIT=4g
IGN_CPUS=2.0

### Module licenses to auto-accept on first boot
# Comma-separated module IDs that are baked into the derived image's
# user-lib/modules. License/cert acceptance still applies even though the
# install pipeline doesn't (modules in user-lib are loaded directly).
ACCEPT_MODULE_LICENSES=com.cirruslink.mqtt.transmission.gateway
ACCEPT_MODULE_CERTS=com.cirruslink.mqtt.transmission.gateway

### Gateway Network outgoing connection (seeded on first boot only)
# Reads from config/central-gateway.env in the deploy workflow; values
# below are the per-site defaults. Override config/central-gateway.env
# per IPC if a site needs different routing.
GAN_HOST=engine-demo.chariot.io
GAN_PORT=8060
GAN_PINGRATE=1000
GAN_ENABLESSL=true
GAN_ENABLED=true

### GitHub Container Registry Information Used for Transfering Containter images to GHCR
GHCR_OWNER=<userName>
GHCR_PAT=<token>