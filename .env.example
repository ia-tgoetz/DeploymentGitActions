##########################################
#
# Environment variable file for
# Ignition 8.3 Edge IPC deployment
#
# Copy to .env and fill in values.
# .env is gitignored — never commit it.
#
##########################################


### Shared
TZ=America/Chicago

### Ignition
IGN_RELEASE=8.3.6

# Image source — defaults to your private GHCR mirror.
# Override to inductiveautomation/ignition:8.3.6 for local dev if you don't
# have GHCR access yet.
IGNITION_IMAGE=ghcr.io/ia-tgoetz/ignition:8.3.6

IGN_NAME=ignition-edge
IGN_PORT=8088
IGN_HTTPS_PORT=8043
IGN_GAN_PORT=8060
IGN_UID=1000
IGN_GID=1000
IGN_MODE=prod

### Gateway credentials
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=changeme

### Third-party modules to auto-accept on first boot
# Comma-separated module IDs (Java package style — the value in module.xml's
# <id> element, e.g. com.cirruslink.mqtt.transmission). NOT the resource-
# folder path (which has a .gateway suffix), NOT the display name.
# .modl files must be present in services/modules/ (run scripts/fetch-modules.sh).
GATEWAY_MODULES_ACCEPTED=com.cirruslink.mqtt.transmission
ACCEPT_MODULE_LICENSES=com.cirruslink.mqtt.transmission
ACCEPT_MODULE_CERTS=com.cirruslink.mqtt.transmission

### GitHub Container Registry Information Used for Transfering Containter images to GHCR
GHCR_OWNER=<userName>
GHCR_PAT=<token>